# /apps/bash/bashrc - read by every interactive bash first (SYS_BASHRC,
# ports/bash/build.sh), then ~/.bashrc. A prompt and colours by default.
[ -z "$PS1" ] && return
# (the prompt: bash's own default replaced, one given by the caller kept)
case $PS1 in
    '\s-\v\$ ') PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ ' ;;
esac
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -l'
alias la='ls -A'
# help: Banana OS's (/bin/help: the system's commands); bash's own: enable help
enable -n help
HISTSIZE=1000
HISTFILESIZE=2000
# a command that comes as an optional package: how to get it
command_not_found_handle() {
    case $1 in
        nvim) printf '%s: not installed - apt install neovim\n' "$1" >&2 ;;
        *) printf 'bash: %s: command not found\n' "$1" >&2 ;;
    esac
    return 127
}
