PALETTE = ["#3A7BD5", "#57B65A", "#E07040", "#8A5CD0", "#D0A030", "#30A8A8", "#C04C70"]


def color_of(name):
    h = 0
    for ch in name:
        h = (h * 31 + ord(ch)) & 0xFFFFFFFF
    return PALETTE[h % len(PALETTE)]


def icon_html(e, size=48):
    if e.get("Icon"):
        return '<img class="icon" src="/%s" alt="" width="%d" height="%d">' % (html.escape(e["Icon"]), size, size)
    t = e.get("Title", e["Package"]) or "?"
    return '<span class="icon" style="background:%s">%s</span>' % (color_of(e["Package"]), html.escape(t[0].upper()))


def page(title, body, repo_name):
    return ("<!doctype html><html><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body><header><h1><a href='/'>%s</a></h1>"
            "<p>Banana OS packages</p></header><main>%s</main><footer>banana-pkgd - <a href='/upload'>upload</a> - "
            "<a href='/api/packages'>JSON</a></footer></body></html>") % (
        html.escape(title), CSS, html.escape(repo_name), body)


def base_url(handler):
    host = handler.headers.get("X-Forwarded-Host") or handler.headers.get("Host") or "localhost"
    proto = handler.headers.get("X-Forwarded-Proto") or "http"
    return "%s://%s" % (proto, host)


# ── the server ────────────────────────────────────────────────────────

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "banana-pkgd/1.0"
    repo = "."
    max_upload = 200 << 20
    repo_name = "Banana OS repository"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def send(self, status, body, ctype="text/html; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def send_json(self, status, obj):
        self.send(status, json.dumps(obj, indent=1) + "\n", "application/json")

    # files apt fetches
    def send_file(self, rel):
        parts = [p for p in rel.split("/") if p]
        if not parts or any(p.startswith(".") or p == ".." for p in parts):
            return self.send(404, "not found\n", "text/plain")
        path = os.path.join(self.repo, *parts)
        if not os.path.isfile(path):
            return self.send(404, "not found\n", "text/plain")
        ext = os.path.splitext(path)[1]
        ctype = {".bpk": "application/octet-stream", ".png": "image/png", ".sig": "text/plain",
                 ".pub": "text/plain"}.get(ext, "text/plain; charset=utf-8")
        extra = {"Cache-Control": "no-cache"} if parts[-1] in ("Packages", "Packages.sig") else \
                {"Cache-Control": "public, max-age=86400"}
        self.send(200, open(path, "rb").read(), ctype, extra)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        path = urllib.parse.unquote(u.path)
        q = urllib.parse.parse_qs(u.query)
        if path in ("/Packages", "/Packages.sig", "/repo.pub") or path.startswith(("/pool/", "/icons/")):
            return self.send_file(path)
        if path == "/healthz":
            return self.send(200, "ok\n", "text/plain")
        if path == "/api/packages":
            return self.send_json(200, {"name": self.repo_name, "key": public_key(self.repo), "packages": read_index(self.repo)})
        if path == "/":
            return self.home(q.get("q", [""])[0])
        m = re.fullmatch(r"/package/([a-z0-9_-]{1,24})", path)
        if m:
            return self.package_page(m.group(1))
        if path == "/upload":
            return self.upload_page()
        self.send(404, page("Not found", "<p>Nothing here. <a href='/'>The packages</a></p>", self.repo_name))

    def home(self, query):
        entries = newest(read_index(self.repo))
        if query:
            ql = query.lower()
            entries = [e for e in entries if any(ql in e.get(k, "").lower() for k in ("Package", "Title", "Description", "Category"))]
        url = base_url(self)
        key = public_key(self.repo)
        body = ("<div class=add><b>Add this repository</b> on Banana OS (terminal):"
                "<pre>apt add-repo %s key=%s\napt update</pre>then <code>apt install &lt;name&gt;</code>, or open the App Store.</div>"
                % (html.escape(url), html.escape(key)))
        body += ("<form class=q method=get action='/'><input type=text name=q value='%s' placeholder='Search packages'> "
                 "<button>Search</button></form>" % html.escape(query))
        if not entries:
            body += "<p>%s</p>" % ("Nothing matches." if query else "No packages yet - <a href='/upload'>upload one</a>.")
        body += "<div class=grid>"
        for e in entries:
            body += ("<a class=card href='/package/%s'>%s<div class=t>%s</div><div class=s>%s - %s</div>"
                     "<div class=d>%s</div></a>") % (
                html.escape(e["Package"]), icon_html(e), html.escape(e.get("Title", e["Package"])),
                html.escape(e.get("Category", "") or "Other"), html.escape(e.get("Version", "")),
                html.escape(e.get("Description", "")))
        body += "</div><p class=s>%d package%s</p>" % (len(entries), "" if len(entries) == 1 else "s")
        self.send(200, page(self.repo_name, body, self.repo_name))

    def package_page(self, name):
        versions = [e for e in read_index(self.repo) if e["Package"] == name]
        if not versions:
            return self.send(404, page("Not found", "<p>No package %s. <a href='/'>All packages</a></p>" % html.escape(name), self.repo_name))
        versions.sort(key=lambda e: e.get("Version", "0"), reverse=False)
        e = newest(versions)[0]
        rows = [("Package", e["Package"]), ("Version", e.get("Version", "")), ("Kind", {"gui": "desktop app", "driver": "driver"}.get(e.get("Type"), "terminal app")),
                ("Category", e.get("Category", "") or "Other"), ("Author", e.get("Author", "")), ("Needs", e.get("Depends", "")),
                ("For", e.get("Arch", "")), ("Size", "%d KB" % ((int(e.get("Size", "0")) + 1023) // 1024)), ("SHA-256", e.get("SHA256", ""))]
        body = "<p><a href='/'>&lt; All packages</a></p>%s<h2 style='margin:0 0 4px'>%s</h2><p>%s</p><table>" % (
            icon_html(e, 64), html.escape(e.get("Title", name)), html.escape(e.get("Description", "")))
        body += "".join("<tr><td>%s</td><td>%s</td></tr>" % (k, html.escape(v)) for k, v in rows if v)
        body += "</table><div class=add style='margin-top:16px'><b>Install</b><pre>apt install %s</pre></div>" % html.escape(name)
        others = [v.get("Version", "") for v in versions if v is not e]
        if others:
            body += "<p class=s>Older versions here too: %s</p>" % html.escape(", ".join(others))
        body += "<p><a href='/%s'>Download the .bpk</a></p>" % html.escape(e.get("Filename", ""))
        self.send(200, page(e.get("Title", name), body, self.repo_name))

    def upload_page(self, msg=None, ok=True):
        body = ""
        if msg:
            body += "<div class='msg %s'>%s</div>" % ("ok" if ok else "err", html.escape(msg))
        body += ("<h2>Upload a package</h2><p>A <code>.bpk</code> made with the Banana OS SDK (<code>make</code>). "
                 "Its index entry is made and signed right away; a new version of an app upgrades it everywhere on "
                 "<code>apt upgrade</code>.</p>"
                 "<form method=post action='/api/upload?form=1' enctype='multipart/form-data'>"
                 "<p>Token<br><input type=password name=token autocomplete=off></p>"
                 "<p>Package<br><input type=file name=package accept='.bpk'></p>"
                 "<p><button>Upload</button></p></form>"
                 "<p class=s>From a terminal: <code>banana-repo push %s app.bpk --token TOKEN</code></p>") % html.escape(base_url(self))
        self.send(200, page("Upload", body, self.repo_name))

    def auth(self, form_token=None):
        h = self.headers.get("Authorization", "")
        tok = h[7:].strip() if h.lower().startswith("bearer ") else (form_token or "")
        who = token_owner(self.repo, tok)
        if not who:
            time.sleep(0.5)                     # (slows down guessing)
        return who

    def read_body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > self.max_upload:
            raise Refused(413, "too big (the limit is %d MB)" % (self.max_upload >> 20))
        return self.rfile.read(n) if n > 0 else b""

    def do_POST(self):
        u = urllib.parse.urlsplit(self.path)
        if u.path != "/api/upload":
            return self.send_json(404, {"error": "not found"})
        q = urllib.parse.parse_qs(u.query)
        as_form = "form" in q
        try:
            body = self.read_body()
            ctype = self.headers.get("Content-Type", "")
            token = None
            if ctype.startswith("multipart/form-data"):
                parts = parse_multipart(body, ctype)
                token = (parts.get("token") or (None, b""))[1].decode("utf-8", "replace").strip() or None
                pkg = parts.get("package") or next((v for v in parts.values() if v[0]), None)
                data = pkg[1] if pkg else b""
            else:
                data = body
            who = self.auth(token)
            if not who:
                raise Refused(401, "a valid upload token is needed (banana-pkgd token add)")
            if not data:
                raise Refused(400, "no package in the request")
            mf, changed = add_package(self.repo, data, replace=q.get("replace", ["0"])[0] == "1")
            msg = "%s %s %s" % (mf.get("title", mf["name"]), mf.get("version", ""), "published" if changed else "was already there")
            sys.stderr.write("upload by %s: %s\n" % (who, msg))
            if as_form:
                return self.upload_page(msg, True)
            self.send_json(200, {"ok": True, "name": mf["name"], "version": mf.get("version", ""), "changed": changed, "message": msg})
        except Refused as e:
            if as_form:
                return self.upload_page(str(e), False)
            self.send_json(e.status, {"ok": False, "error": str(e)})

    def do_DELETE(self):
        m = re.fullmatch(r"/api/packages/([a-z0-9_-]{1,24})(?:/([0-9A-Za-z.+~_-]{1,23}))?", urllib.parse.urlsplit(self.path).path)
        if not m:
            return self.send_json(404, {"error": "not found"})
        who = self.auth()
        if not who:
            return self.send_json(401, {"ok": False, "error": "a valid upload token is needed"})
        gone = remove_package(self.repo, m.group(1), m.group(2))
        if not gone:
            return self.send_json(404, {"ok": False, "error": "no such package"})
        sys.stderr.write("removed by %s: %s %s\n" % (who, m.group(1), m.group(2) or "(all versions)"))
        self.send_json(200, {"ok": True, "removed": gone})


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def serve(d, args):
    bind, port, max_mb = "127.0.0.1", 8080, 200
    i = 0
    while i < len(args):
        if args[i] == "--bind" and i + 1 < len(args):
            bind = args[i + 1]; i += 2
        elif args[i] == "--port" and i + 1 < len(args):
            port = int(args[i + 1]); i += 2
        elif args[i] == "--max-upload" and i + 1 < len(args):
            max_mb = int(args[i + 1]); i += 2
        else:
            die("unknown option " + args[i])
    if not os.path.exists(os.path.join(d, ".banana-repo.json")):
        die("%s is not a repository (banana-pkgd init %s)" % (d, d))
    br.build_index(d, quiet=True)             # (files copied in by hand meanwhile)
    Handler.repo = os.path.abspath(d)
    Handler.max_upload = max_mb << 20
    Handler.repo_name = json.load(open(os.path.join(d, ".banana-repo.json"))).get("name", "Banana OS repository")
    if not load_conf(d)["tokens"]:
        print("banana-pkgd: no upload tokens - uploads are refused (banana-pkgd token add %s NAME)" % d, file=sys.stderr)
    with Server((bind, port), Handler) as httpd:
        print("banana-pkgd: %s on http://%s:%d/ (%d packages)" % (Handler.repo_name, bind, port, len(newest(read_index(d)))), flush=True)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = argv[1]
    if cmd == "init":
        if len(argv) < 3:
            die("usage: banana-pkgd init DIR [--name NAME] [--key KEYFILE]")
        d = argv[2]
        if os.path.exists(os.path.join(d, ".banana-repo.json")):
            print("banana-pkgd: %s is a repository already - kept" % d)
        else:
            br.cmd_init(d, argv[3:])
        if not load_conf(d)["tokens"]:
            tok = new_token(d, "admin")
            print("\nUpload token \"admin\" (shown only now - keep it):\n    %s\n" % tok)
        return
    if cmd == "serve":
        if len(argv) < 3:
            die("usage: banana-pkgd serve DIR [--bind ADDR] [--port N] [--max-upload MB]")
        return serve(argv[2], argv[3:])
    if cmd == "token":
        if len(argv) < 4:
            die("usage: banana-pkgd token add|list|remove DIR [NAME]")
        sub, d = argv[2], argv[3]
        if sub == "add" and len(argv) > 4:
            tok = new_token(d, argv[4])
            print("Upload token \"%s\" (shown only now):\n    %s" % (argv[4], tok))
        elif sub == "list":
            for t in load_conf(d)["tokens"]:
                print("%-20s created %s" % (t["name"], t.get("created", "")))
        elif sub == "remove" and len(argv) > 4:
            c = load_conf(d)
            n = len(c["tokens"])
            c["tokens"] = [t for t in c["tokens"] if t["name"] != argv[4]]
            if len(c["tokens"]) == n:
                die("no token %s" % argv[4])
            save_conf(d, c)
            print("removed token %s" % argv[4])
        else:
            die("usage: banana-pkgd token add|list|remove DIR [NAME]")
        return
    die("unknown command %s (init, serve, token)" % cmd)


if __name__ == "__main__":
    main(sys.argv)
