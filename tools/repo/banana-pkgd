#!/usr/bin/env python3
"""banana-pkgd - the Banana OS package server.

Serves a package repository to Banana OS (apt, the App Store), shows it as
web pages, and takes new packages over HTTP - each upload is checked, put in
the pool, and the index re-made and signed at once.

  banana-pkgd init DIR [--name NAME] [--key KEYFILE]
                       a new repository (and its signing key) plus a first
                       upload token, printed once
  banana-pkgd serve DIR [--bind 127.0.0.1] [--port 8080] [--max-upload 200]
                       run the server (max upload in MB)
  banana-pkgd token add DIR NAME      a new upload token (printed once)
  banana-pkgd token list DIR
  banana-pkgd token remove DIR NAME

HTTP:
  GET  /                      the packages (search: /?q=word), how to add the repository
  GET  /package/NAME          one package
  GET  /upload                a form to upload a .bpk (with a token) - works from
                              Banana OS's own browser too
  GET  /Packages /Packages.sig /repo.pub /pool/... /icons/...   what apt fetches
  GET  /api/packages          the index as JSON
  POST /api/upload            a .bpk: the raw body (Content-Type
                              application/octet-stream) or multipart/form-data
                              (field "package"); Authorization: Bearer TOKEN
  DELETE /api/packages/NAME[/VERSION]   (token) take a package out
  GET  /healthz

Publish from anywhere:  banana-repo push https://pkgs.example.org app.bpk --token TOKEN
Put it behind nginx for HTTPS (tools/repo/install-server.sh does it all).
Needs Python 3.8+ and banana-repo (next to this file or in $PATH); nothing else.
"""
import hashlib
import hmac
import html
import http.server
import importlib.machinery
import importlib.util
import json
import os
import re
import secrets
import shutil
import socketserver
import sys
import tempfile
import threading
import time
import urllib.parse

sys.dont_write_bytecode = True


def _load_repo_tool():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "banana-repo"), shutil.which("banana-repo") or ""):
        if p and os.path.isfile(p):
            loader = importlib.machinery.SourceFileLoader("bananarepo", p)
            spec = importlib.util.spec_from_loader("bananarepo", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    sys.exit("banana-pkgd: banana-repo not found (put it next to banana-pkgd or in $PATH)")


br = _load_repo_tool()

CONF = ".banana-pkgd.json"
LOCK = threading.Lock()


def die(msg):
    print("banana-pkgd: " + msg, file=sys.stderr)
    sys.exit(1)


# ── configuration: upload tokens (only their SHA-256 is kept) ─────────

def conf_path(d):
    return os.path.join(d, CONF)


def load_conf(d):
    p = conf_path(d)
    if not os.path.exists(p):
        return {"tokens": []}
    return json.load(open(p))


def save_conf(d, c):
    p = conf_path(d)
    tmp = p + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(c, f, indent=1)
    os.replace(tmp, p)


def new_token(d, name):
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,40}", name):
        die("a token name is letters, digits, . _ - (40 at most)")
    c = load_conf(d)
    if any(t["name"] == name for t in c["tokens"]):
        die("there is a token %s already (token remove first)" % name)
    tok = "bpk_" + secrets.token_urlsafe(32)
    c["tokens"].append({"name": name, "sha256": hashlib.sha256(tok.encode()).hexdigest(),
                        "created": time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime())})
    save_conf(d, c)
    return tok


def token_owner(d, tok):
    """the name of the token, or None"""
    if not tok:
        return None
    h = hashlib.sha256(tok.encode()).hexdigest()
    found = None
    for t in load_conf(d)["tokens"]:
        if hmac.compare_digest(t["sha256"], h):
            found = t["name"]
    return found


# ── the index, read back for the pages ────────────────────────────────

def read_index(d):
    p = os.path.join(d, "Packages")
    if not os.path.exists(p):
        return []
    out = []
    for stanza in open(p, encoding="utf-8").read().split("\n\n"):
        f = {}
        for line in stanza.splitlines():
            if line.startswith("#") or ": " not in line:
                continue
            k, v = line.split(": ", 1)
            f[k] = v
        if "Package" in f:
            out.append(f)
    return out


def newest(entries):
    """one entry per package: its newest version"""
    best = {}
    for e in entries:
        n = e["Package"]
        if n not in best or br.vercmp(e.get("Version", "0"), best[n].get("Version", "0")) > 0:
            best[n] = e
    return sorted(best.values(), key=lambda e: e.get("Title", e["Package"]).lower())


def public_key(d):
    p = os.path.join(d, "repo.pub")
    return open(p).read().strip() if os.path.exists(p) else ""


# ── adding and removing packages ──────────────────────────────────────

class Refused(Exception):
    def __init__(self, status, msg):
        super().__init__(msg)
        self.status = status


def add_package(d, data, replace=False):
    """checks a .bpk (bytes) and publishes it; returns its manifest"""
    inc = os.path.join(d, ".incoming")
    os.makedirs(inc, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=inc, suffix=".bpk")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        try:
            _, files = br.read_bpk(tmp)
            mf = br.manifest_of(files)
            br.arches(files, mf.get("type", "console"))
        except (ValueError, SystemExit) as e:
            raise Refused(400, "not a valid Banana OS package: %s" % e)
        ver = mf.get("version", "0") or "0"
        dest = os.path.join(d, "pool", "%s_%s.bpk" % (mf["name"], ver))
        with LOCK:
            if os.path.exists(dest) and not replace:
                if open(dest, "rb").read() == data:
                    return mf, False
                raise Refused(409, "%s %s is already published with other contents - give it a new version "
                                   "(Banana OS only upgrades to a higher one), or add ?replace=1" % (mf["name"], ver))
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            os.replace(tmp, dest)
            tmp = None
            br.build_index(d, quiet=True)
        return mf, True
    finally:
        if tmp and os.path.exists(tmp):
            os.remove(tmp)


def remove_package(d, name, ver=None):
    pool = os.path.join(d, "pool")
    gone = 0
    with LOCK:
        for fn in os.listdir(pool):
            m = re.fullmatch(r"(.+?)_(.+)\.bpk", fn)
            if m and m.group(1) == name and (ver is None or m.group(2) == ver):
                os.remove(os.path.join(pool, fn))
                gone += 1
        if gone:
            br.build_index(d, quiet=True)
    return gone


def parse_multipart(body, ctype):
    """{name: (filename or None, bytes)} of a multipart/form-data body"""
    m = re.search(r'boundary="?([^";]+)"?', ctype)
    if not m:
        return {}
    b = b"--" + m.group(1).encode()
    out = {}
    for part in body.split(b)[1:]:
        if part.startswith(b"--"):
            break
        head, _, data = part.partition(b"\r\n\r\n")
        if data.endswith(b"\r\n"):
            data = data[:-2]
        h = head.decode("utf-8", "replace")
        nm = re.search(r'name="([^"]*)"', h)
        fn = re.search(r'filename="([^"]*)"', h)
        if nm:
            out[nm.group(1)] = (fn.group(1) if fn else None, data)
    return out


